# Copy to .env and fill in. These values are bundled into the app, so ONLY
# public values belong here. Never add a service_role / secret key.

# Project URL — local: http://127.0.0.1:54321 (from `npx supabase status`).
# On a physical phone use your computer's LAN IP instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=

# Public client key: the "anon" key or the newer "publishable" key (sb_publishable_...).
# Set either one.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for `npm run test:db` (any PostgreSQL 15+ server, superuser).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
